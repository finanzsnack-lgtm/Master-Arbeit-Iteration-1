# Reisebot-Prototyp – Umgebungsvariablen (Vorlage)
#
# Kopiere diese Datei zu ".env" und trage dort die echten Werte ein.
# Die ".env" selbst wird NIE eingecheckt (siehe .gitignore) und darf NIE im
# Chat/Log auftauchen (CLAUDE.md-Vorgabe: "Key in .env, nie im Code/Repo").

# Solange kein Google-Maps-Key hinterlegt ist, läuft der komplette API-Layer
# mit Beispieldaten (src/api/mock_data.py). Auf false setzen, sobald ein
# echter Key eingetragen ist.
MOCK_MODE=true

GOOGLE_MAPS_API_KEY=

# Mailjet Send API v3.1 (src/ausgabe/reiseplan.py::sende_mail). Ohne diese
# drei Werte wird der Reiseplan weiterhin nur als Datei gespeichert
# (speichere_datei), es wird KEINE Mail verschickt.
# API-Key + Secret Key: https://app.mailjet.com/account/apikeys
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Muss im Mailjet-Account als Absenderadresse verifiziert sein
# (https://app.mailjet.com/account/sender), sonst lehnt Mailjet den Versand ab.
MAILJET_ABSENDER=

# Tagesbudget in Minuten INKL. Fahrzeit, das Optimierung 1 verwendet, solange
# der Fragekatalog dafür kein eigenes Feld liefert (siehe Kommentar in
# src/datenaufbereitung/aufbereitung.py). 480 = 8 Stunden.
STANDARD_TAGESBUDGET_MINUTEN=480

# Maximale reine Aktivitätszeit pro Tag in Minuten, OHNE Fahrzeit (härtere
# Nebenbedingung als STANDARD_TAGESBUDGET_MINUTEN, siehe src/optimierung/
# toptw.py). 360 = 6 Stunden.
MAX_AKTIVITAETSZEIT_MINUTEN=360

# Modell für die Claude-Agent-SDK-Dialogsession (chat.py). Explizit gesetzt
# statt das Modell der umgebenden Claude-Code-Session zu erben – prüfe, für
# welches Modell dein Payment-Segment/Abo gilt (z.B. claude-opus-5,
# claude-sonnet-5, claude-haiku-4-5-20251001).
LLM_MODELL=claude-opus-5

# Sprachmodus für chat.py: Mikrofon statt Tastatur, Stimme statt Konsolentext.
AUDIO_MODUS=false

# "google_cloud" (empfohlen: natürlichere Stimme, bessere Erkennung, braucht
# API-Key + in der Google Cloud Console aktivierte "Cloud Text-to-Speech API"
# und "Cloud Speech-to-Text API" im selben Projekt wie Maps) oder "lokal"
# (Whisper + pyttsx3, kein Key nötig, aber schlechtere Qualität – erfordert
# zusätzlich: pip install -r requirements-audio.txt).
AUDIO_ANBIETER=google_cloud

# Nur für AUDIO_ANBIETER=google_cloud: eigener Key, oder leer lassen, dann
# wird automatisch GOOGLE_MAPS_API_KEY verwendet (meist dasselbe Projekt).
GOOGLE_CLOUD_SPEECH_API_KEY=

# Nur für AUDIO_ANBIETER=lokal. tiny/base/small/medium/large – größer =
# genauer, aber langsamer/mehr RAM.
WHISPER_MODELL_GROESSE=base
